@import "./rofi_theme.rasi"

configuration {
    show-icons:                     true;
    hover-select:                   true;
    me-select-entry:                "";
    me-accept-entry:                "MousePrimary";
}

* {
    /* Aquí llamamos a las variables de tu rofi_theme.rasi */
    bg-col:       @background;
    border-col:   @active-background;
    selected-col: @selected-normal-background;
    font:         "JetBrains Mono 11";
    background-color: transparent;
    text-color:   @foreground;
}

window {
    background-color: @bg-col;
    border-radius: 20px;
    padding:      0px;

    location:         south;
    anchor:           south;
    y-offset:         -10px;
}

mainbox {
    spacing:      15px;
    children:     [  listview ];
}

prompt {
    background-color: @border-col;
    text-color:   @bg-col;
    padding:      10px 15px;
    border-radius: 8px;
}

entry {
    padding:      10px;
    background-color: @selected-col;
    border-radius: 8px;
    placeholder:  "Buscar fondo...";
    placeholder-color: @alternate-normal-foreground;
}

listview {
    columns:      3;
    lines:        1;
    spacing:      2px;
    cycle:        true;
    dynamic:      true;
    layout:       vertical;
    scrollbar:    false;
}

element {
    children:     [ element-icon ];
    orientation:  vertical;
    padding:      4px;
    border-radius: 20px;
    cursor:       pointer;
}

element selected {
    border:           2px solid;
    border-color:     @border-col;
}

element-icon {
    size:         200px;
    cursor:       inherit;
    horizontal-align: 0.5;
    border-radius: 20px;
}
