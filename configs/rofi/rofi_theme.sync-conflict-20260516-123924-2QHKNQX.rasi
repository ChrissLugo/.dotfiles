* {
    active-background: #edc06c;
    active-foreground: #ece1d4;
    normal-background: #17130b;
    normal-foreground: #ece1d4;
    urgent-background: #ffb4ab;
    urgent-foreground: #ece1d4;

    alternate-active-background: #17130b;
    alternate-active-foreground: #ece1d4;
    alternate-normal-background: #17130b;
    alternate-normal-foreground: #ece1d4;
    alternate-urgent-background: #17130b;
    alternate-urgent-foreground: #ece1d4;

    selected-active-background: #ffb4ab;
    selected-active-foreground: #ece1d4;
    selected-normal-background: #edc06c;
    selected-normal-foreground: #ece1d4;
    selected-urgent-background: #b3cea6;
    selected-urgent-foreground: #ece1d4;

    background-color: #17130b;
    background: #17130b;
    foreground: #ece1d4;
    border-color: @active-background;
    spacing: 2;
}
