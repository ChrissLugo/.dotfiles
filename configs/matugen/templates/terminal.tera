#!/usr/bin/env sh
# Set term colors script - Generated by Matugen (Vibrant Colors Fix)

seqs=""

# Colores Normales (0-7)
seqs="${seqs}\033]4;0;#{{colors.surface.default.hex_stripped}}\a"
seqs="${seqs}\033]4;1;#{{colors.error.default.hex_stripped}}\a"
seqs="${seqs}\033]4;2;#{{colors.primary.default.hex_stripped}}\a"
seqs="${seqs}\033]4;3;#{{colors.tertiary.default.hex_stripped}}\a"
# Aquí ponemos colores más vivos para el logo y el usuario (4, 5 y 6)
seqs="${seqs}\033]4;4;#{{colors.primary.default.hex_stripped}}\a"
seqs="${seqs}\033]4;5;#{{colors.tertiary.default.hex_stripped}}\a"
seqs="${seqs}\033]4;6;#{{colors.primary.default.hex_stripped}}\a"
seqs="${seqs}\033]4;7;#{{colors.on_surface.default.hex_stripped}}\a"

# Colores Brillantes (8-15) - Usamos los mismos tonos vivos para el texto en negrita
seqs="${seqs}\033]4;8;#{{colors.surface_variant.default.hex_stripped}}\a"
seqs="${seqs}\033]4;9;#{{colors.error.default.hex_stripped}}\a"
seqs="${seqs}\033]4;10;#{{colors.primary.default.hex_stripped}}\a"
seqs="${seqs}\033]4;11;#{{colors.tertiary.default.hex_stripped}}\a"
seqs="${seqs}\033]4;12;#{{colors.primary.default.hex_stripped}}\a"
seqs="${seqs}\033]4;13;#{{colors.tertiary.default.hex_stripped}}\a"
seqs="${seqs}\033]4;14;#{{colors.primary.default.hex_stripped}}\a"
seqs="${seqs}\033]4;15;#{{colors.on_surface_variant.default.hex_stripped}}\a"

# Background, Foreground, Cursor & Border
seqs="${seqs}\033]11;#{{colors.surface.default.hex_stripped}}\a"
seqs="${seqs}\033]10;#{{colors.on_surface.default.hex_stripped}}\a"
seqs="${seqs}\033]12;#{{colors.primary.default.hex_stripped}}\a"
seqs="${seqs}\033]7044;#{{colors.outline.default.hex_stripped}}\a"

# Enviar las secuencias a todas las terminales abiertas
for pts in /dev/pts/[0-9]*; do
    if [ -w "$pts" ]; then
        printf "%b" "$seqs" > "$pts"
    fi
done
